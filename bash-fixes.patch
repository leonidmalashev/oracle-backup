+    echo 'FAIL: --silent wrote routine runner messages' >&2
+    exit 1
+fi
+echo 'PASS: --silent suppresses routine runner messages'
+rm -- "$test_dir/job-runner.sh.log" "$test_dir/starts" "$test_dir/finished"
