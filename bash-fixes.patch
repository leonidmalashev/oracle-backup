+    if $_job_started; then
+        if ! $_silent || [[ $status -ne 0 ]]; then
+            printf '%s finish --job-name=%s --status=%s --signal=%s\n' \
+                "$(log_prefix)" "$(log_escape "$_job_name")" "$status" "$(log_escape "${_signal:-none}")" >&2 || true
+        fi
+    fi
+    exit "$status"
+}
+
+handle_signal() {
