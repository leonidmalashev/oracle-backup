+            exit 2
+        fi
+        printf 'rman-backup.%s.%s\n' "$sid" "$task"
+        return 0
+    fi
+    printf '%s\n' "$_job_name"
+}
+
+cleanup() {
+    local status=$?
+    trap - EXIT ERR
+    trap '' INT TERM HUP
+    set +e
+    if [[ -n $_child_pid ]]; then
+        # Async children can inherit ignored SIGINT; TERM also works for them.
+        kill -TERM -- "$_child_pid" 2>/dev/null || true
+        wait "$_child_pid" 2>/dev/null || true
+    fi
+    if $_job_started; then
+        if ! $_silent || [[ $status -ne 0 ]]; then
+            printf '%s finish job=%s status=%s signal=%s\n' \
+                "$(log_prefix)" "$(log_escape "$_job_name")" "$status" "$(log_escape "${_signal:-none}")" >&2 || true
+        fi
+    fi
+    exit "$status"
+}
+
+handle_signal() {
+    _signal=$2
+    exit "$1"
+}
